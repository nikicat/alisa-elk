YANDEX_SKILL_ID=00000000-0000-0000-0000-000000000000
WEBHOOK_PATH_SECRET=replace_with_32_hex_chars
LLM_BASE_URL=https://router.example/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=yandexgpt-lite/latest
DB_URL=sqlite:///./elk.db
LOG_LEVEL=INFO

# Optional outbound HTTP proxy for LLM calls (httpx honors these automatically).
# HTTP_PROXY=http://user:pass@proxy.host:8080
# HTTPS_PROXY=http://user:pass@proxy.host:8080
# NO_PROXY=localhost,127.0.0.1

# --- Docker deployment behind Traefik ---
# Domain and subpath where the skill is served.
DOMAIN=yourdomain.example
ROUTE_PREFIX=/elk
# Tell FastAPI it's mounted at this subpath (purely cosmetic for OpenAPI URLs).
ROOT_PATH=/elk
# Existing Traefik bits on the host.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

